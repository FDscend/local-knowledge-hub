DATABASE_URL="file:./prisma/dev.db"
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
OPENAI_MODEL="gpt-4.1-mini"
MINERU_API_KEY=""

# Optional OpenAI-compatible Embedding API. These credentials are intentionally
# separate from the chat LLM credentials above. Leave blank to use FTS5 only.
# Fill the API root, not the final /embeddings endpoint: the client appends it.
# Example (SiliconFlow): https://api.siliconflow.cn/v1, not /v1/embedding.
EMBEDDING_API_KEY=""
EMBEDDING_BASE_URL=""
EMBEDDING_MODEL="text-embedding-3-small"

# DeepSeek is OpenAI-compatible. You can either fill OPENAI_* above,
# or use the DeepSeek-specific aliases below.
# DEEPSEEK_API_KEY="sk-..."
# DEEPSEEK_BASE_URL="https://api.deepseek.com"
# DEEPSEEK_MODEL="deepseek-v4-flash"

# MinerU precise mode uses the token above.
# The default lightweight MinerU mode does not need login or API key.

# Read-only MCP server access scope (阶段 E). Comma-separated knowledge base
# IDs or names that the MCP tools may access. When unset, only the built-in
# "default" inbox is allowed. Tools never accept IDs outside this list.
# MCP_KNOWLEDGE_BASE_IDS="default"

# Optional override for the managed data directory (default: .data/knowledge-base).
# KNOWLEDGE_BASE_DATA_DIR="D:/path/to/data-dir"
